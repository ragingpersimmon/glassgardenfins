{
  "name": "littlefinswim",
  "version": "1.0.0",
  "private": true,
  "description": "Glass Garden Fins static site validation and backtesting",
  "main": "script.js",
  "type": "module",
  "scripts": {
    "build:questions": "node ./tools/build-question-series.mjs && node ./tools/enrich-metadata.mjs && node ./tools/generate-sitemap.mjs",
    "build:site": "npm run build:questions",
    "set:amazon-tag": "node ./tools/set-amazon-tag.mjs",
    "test": "npm run test:setup && npm run validate:site && npm run test:scheduled && npm run test:mutations && npm run test:deterministic && npm run test:chaos",
    "validate:site": "node ./tools/validate-site.mjs",
    "test:scheduled": "node ./tools/publish-scheduled-entry.test.mjs",
    "test:mutations": "node ./tools/chaos-test.mjs",
    "test:deterministic": "node tests/deterministic.cjs",
    "test:chaos": "node tests/chaos.cjs",
    "test:setup": "playwright install chromium"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/ragingpersimmon/littlefinswim"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
